---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | FSI Engineering - Schedule Inspection">
  <section class="bg-slate-950 text-white py-16 lg:py-20 bg-blueprint-grid border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-900/40 border border-blue-500/30 text-blue-300 text-xs font-mono-tech uppercase tracking-wider mb-4">
        Direct Dispatch Office
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">Contact FSI Engineering</h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto">
        Speak directly with our Texas Licensed Professional Engineering dispatch team or submit your site details for immediate scheduling.
      </p>
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-slate-950 text-white">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Direct Contact Info Card -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-slate-900 rounded-3xl border border-slate-800 p-8 shadow-xl space-y-8">
          <div>
            <h2 class="text-xl font-bold text-white mb-2">Priority Engineering Line</h2>
            <p class="text-sm text-slate-400 leading-relaxed">
              Facing an active 3–7 day option period, noticed severe slab cracking, or need a city permit structural letter? Contact us immediately.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0 border border-blue-500/30">
                <svg class="w-6 h-6 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider font-mono-tech">Telephone Dispatch</p>
                <a href="tel:9452570898" class="text-lg font-bold text-white hover:text-blue-400 transition-colors">
                  (945) 257-0898
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0 border border-blue-500/30">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider font-mono-tech">Email Inquiries</p>
                <a href="mailto:Info@foundationstructureinspection.com" class="text-base font-bold text-white hover:text-blue-400 transition-colors break-all">
                  Info@foundationstructureinspection.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0 border border-blue-500/30">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider font-mono-tech">Coverage Region</p>
                <p class="text-base font-bold text-white">
                  DFW Metroplex (Dallas, Tarrant, Collin, Denton Counties)
                </p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 text-xs text-slate-400 leading-relaxed font-mono-tech">
            <span class="text-emerald-400 block font-bold mb-1">GUARANTEED SAME-DAY PE REPORT DELIVERY</span>
            Official reports include electronic manometer contour surveys and legal Texas Professional Engineer seal.
          </div>
        </div>
      </div>

      <!-- Frictionless Contact / Booking Form -->
      <div class="lg:col-span-7">
        <div class="bg-slate-900 rounded-3xl border border-slate-800 p-8 sm:p-10 shadow-xl">
          <h2 class="text-2xl font-bold text-white mb-2">Request Property Inspection</h2>
          <p class="text-sm text-slate-400 mb-8 font-telemetry">
            Complete the form below. Results dispatch directly to our engineering coordinator.
          </p>

          <form id="contact-page-form" action="https://formsubmit.co/mahmoudi.6486@gmail.com" method="POST" class="space-y-6">
            <input type="hidden" name="_subject" value="New Contact Inquiry from FSI Website" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <input type="text" name="_honey" style="display:none" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="contact-name" class="block text-sm font-semibold text-slate-300 mb-2">Full Name *</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="Name" 
                  required 
                  placeholder="Your Name" 
                  class="w-full px-4 py-3.5 rounded-xl border border-slate-700 bg-slate-950 text-base text-white focus:ring-2 focus:ring-blue-500 outline-none transition" 
                />
              </div>

              <div>
                <label for="contact-phone" class="block text-sm font-semibold text-slate-300 mb-2">Phone Number *</label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="Phone" 
                  inputmode="tel"
                  required 
                  placeholder="(945) 000-0000" 
                  class="w-full px-4 py-3.5 rounded-xl border border-slate-700 bg-slate-950 text-base text-white focus:ring-2 focus:ring-blue-500 outline-none transition" 
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="contact-email" class="block text-sm font-semibold text-slate-300 mb-2">Email Address *</label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="Email" 
                  required 
                  placeholder="name@email.com" 
                  class="w-full px-4 py-3.5 rounded-xl border border-slate-700 bg-slate-950 text-base text-white focus:ring-2 focus:ring-blue-500 outline-none transition" 
                />
              </div>

              <div>
                <label for="contact-subject" class="block text-sm font-semibold text-slate-300 mb-2">Service / Property Category *</label>
                <select 
                  id="contact-subject" 
                  name="InspectionCategory" 
                  class="w-full px-4 py-3.5 rounded-xl border border-slate-700 bg-slate-950 text-base text-white focus:ring-2 focus:ring-blue-500 outline-none transition"
                >
                  <option value="Residential Option Period">Residential (Active 3-7 Day Option Period)</option>
                  <option value="Residential Deflection Concern">Residential (Cracked Slab / Walls)</option>
                  <option value="Commercial Due Diligence">Commercial Facility Inspection</option>
                  <option value="Load-Bearing Wall Remodel">Load-Bearing Wall Assessment</option>
                  <option value="New Construction Review">New Construction Inspection</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-address" class="block text-sm font-semibold text-slate-300 mb-2">Property Address & City (DFW Metroplex) *</label>
              <input 
                type="text" 
                id="contact-address" 
                name="PropertyAddress" 
                required 
                autocomplete="street-address"
                placeholder="e.g. 100 Main St, Dallas, TX" 
                class="w-full px-4 py-3.5 rounded-xl border border-slate-700 bg-slate-950 text-base text-white focus:ring-2 focus:ring-blue-500 outline-none transition" 
              />
            </div>

            <div>
              <label for="contact-message" class="block text-sm font-semibold text-slate-300 mb-2">Symptoms or Specific Deadlines (Optional)</label>
              <textarea 
                id="contact-message" 
                name="Notes" 
                rows="4" 
                placeholder="Option period expiration time, visible cracks, buyer/seller questions..." 
                class="w-full px-4 py-3.5 rounded-xl border border-slate-700 bg-slate-950 text-base text-white focus:ring-2 focus:ring-blue-500 outline-none transition"
              ></textarea>
            </div>

            <button 
              id="contact-submit-btn"
              type="submit" 
              class="w-full py-4 px-8 rounded-xl font-bold text-base text-white bg-blue-600 hover:bg-blue-500 shadow-xl shadow-blue-600/30 transition-all cursor-pointer hover:-translate-y-0.5 flex items-center justify-center gap-2"
            >
              <span id="contact-btn-text">Submit Inspection Request</span>
              <span id="contact-spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
            </button>

            <!-- Success Notification -->
            <div id="contact-success" class="hidden p-4 rounded-xl bg-emerald-950 border border-emerald-800 text-emerald-300 text-sm font-medium text-center">
              ✓ Inspection request submitted! Our engineering team will contact you within 30 minutes.
            </div>
            <div id="contact-error" class="hidden p-4 rounded-xl bg-red-950 border border-red-800 text-red-300 text-sm font-medium text-center">
              ✕ Temporary issue submitting. Please contact us directly at mahmoudi.6486@gmail.com.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-page-form') as HTMLFormElement;
    const feedback = document.getElementById('contact-success');
    const errorBanner = document.getElementById('contact-error');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('contact-btn-text');
    const spinner = document.getElementById('contact-spinner');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Submitting...';
        if (spinner) spinner.classList.remove('hidden');
        if (errorBanner) errorBanner.classList.add('hidden');

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            if (feedback) feedback.classList.remove('hidden');
            form.reset();
            feedback?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            form.submit();
          }
        } catch (err) {
          if (errorBanner) errorBanner.classList.remove('hidden');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Submit Inspection Request';
          if (spinner) spinner.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
