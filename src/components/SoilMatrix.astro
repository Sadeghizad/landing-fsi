---
// src/components/SoilMatrix.astro
const cities = [
  "Dallas", "Fort Worth", "Arlington", "Plano", "Frisco", 
  "McKinney", "Denton", "Irving", "Garland", "Richardson", 
  "Allen", "Grand Prairie", "Carrollton", "Lewisville", "Flower Mound", 
  "Mansfield", "North Richland Hills", "Grapevine", "Euless", "Bedford"
];
---

<section class="py-24 bg-[#0B111E] text-white relative" id="soil">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-400/20 text-blue-300 text-xs font-telemetry uppercase tracking-wider mb-4">
        Local Geotechnical Reality
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
        Why DFW Foundations Move — And Why Most Don't Need Piers.
      </h2>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        The science of North Texas expansive clay soils explained by licensed Professional Engineers.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
      
      <!-- Geotechnical Explanation (6 Cols) -->
      <div class="lg:col-span-6 glass-card rounded-3xl p-8 sm:p-10 border border-slate-700/80 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center gap-2 text-xs font-telemetry text-red-400 uppercase">
            <span>● EAGLE FORD SHALE & HOUSTON BLACK CLAY</span>
          </div>

          <h3 class="text-2xl font-bold text-white">
            The North Texas Moisture-Heave Cycle
          </h3>

          <p class="text-sm text-slate-300 leading-relaxed">
            The Dallas-Fort Worth metroplex rests on highly expansive clay formations. During hot Texas summers, soil desiccation causes soil to shrink dramatically away from perimeter grade beams. During heavy rainfall seasons, clays expand with massive hydraulic uplift forces.
          </p>

          <p class="text-sm text-slate-300 leading-relaxed">
            This natural swelling creates cosmetic sheetrock fissures, corner brick step-cracks, and sticking interior doors. While alarming to homeowners, <strong>these symptoms frequently represent seasonal soil moisture fluctuations rather than structural foundation failure.</strong>
          </p>

          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-xs font-telemetry text-emerald-400">
            ✓ Only a licensed Professional Engineer (PE) has the legal authority and technical education to distinguish natural seasonal movement from true structural failure.
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 text-xs text-slate-400 font-telemetry">
          Diagnostic Method: Electronic Manometer Differential Elevation Contours.
        </div>
      </div>

      <!-- Regional Coverage Matrix (6 Cols) -->
      <div class="lg:col-span-6 glass-card rounded-3xl p-8 sm:p-10 border border-slate-700/80 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-telemetry text-blue-400 uppercase tracking-wider font-bold">
              REGIONAL COVERAGE
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[11px] font-telemetry">
              SAME-DAY DISPATCH ACTIVE
            </span>
          </div>

          <h3 class="text-2xl font-bold text-white mb-2">
            Serving the Entire DFW Metroplex
          </h3>
          <p class="text-xs text-slate-300 mb-6 leading-relaxed">
            Our engineers provide prompt on-site foundation and structural evaluations throughout Dallas, Tarrant, Collin, and Denton counties:
          </p>

          <!-- Cities Badges Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
            {cities.map((city) => (
              <div class="px-3 py-2 rounded-xl bg-slate-900/90 border border-slate-800 text-xs font-telemetry text-slate-200 flex items-center gap-1.5 hover:border-blue-500/40 transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                <span>{city}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between text-xs font-telemetry">
          <span class="text-slate-400">Surrounding Cities Included</span>
          <a href="#schedule" class="text-blue-400 font-bold hover:text-blue-300 transition-colors">
            Check My Address →
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
