---
// src/components/VSLModal.astro
---

<section class="py-20 bg-[#070B14] relative overflow-hidden" id="vsl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-400/20 text-blue-300 text-xs font-telemetry uppercase tracking-wider mb-4">
        The 90-Second Reality Check
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
        Why 60% of Foundation Repair Quotes in DFW Are Unnecessary.
      </h2>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        Watch our Texas Licensed Professional Engineers demonstrate how independent floor mapping saves homeowners tens of thousands.
      </p>
    </div>

    <!-- Video Theater Frame -->
    <div class="max-w-4xl mx-auto relative rounded-3xl overflow-hidden glass-card border border-slate-700/80 shadow-2xl group">
      
      <!-- Video Container with Simulated Player -->
      <div class="aspect-video w-full bg-[#030712] relative flex items-center justify-center overflow-hidden">
        
        <!-- Video Poster Background Graphic -->
        <div class="absolute inset-0 bg-gradient-to-tr from-slate-950 via-slate-900 to-blue-950/40 opacity-80"></div>
        <div class="absolute inset-0 bg-blueprint-grid opacity-30"></div>

        <!-- Watermark Badges -->
        <div class="absolute top-4 left-4 z-10 flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/90 border border-slate-700/80 text-xs font-telemetry text-slate-300">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          <span>DFW MARKET INVESTIGATION</span>
        </div>

        <div class="absolute top-4 right-4 z-10 px-3 py-1.5 rounded-lg bg-blue-900/80 border border-blue-500/30 text-xs font-telemetry text-blue-300">
          Duration: 01:28
        </div>

        <!-- Center Interactive Play Button -->
        <div class="relative z-20 text-center cursor-pointer group-hover:scale-105 transition-transform" id="video-play-trigger">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-blue-600/90 text-white flex items-center justify-center shadow-2xl shadow-blue-500/50 border-2 border-white/20 mx-auto mb-4 group-hover:bg-blue-500 transition-colors">
            <svg class="w-8 h-8 sm:w-10 sm:h-10 ml-1 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
          <span class="inline-block px-4 py-1.5 rounded-full bg-slate-950/80 border border-slate-700 text-xs font-telemetry text-white font-semibold">
            Click to Play Video Breakdown
          </span>
        </div>

        <!-- Bottom Chapter Timeline Markers -->
        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent p-4 flex flex-wrap items-center justify-between gap-2 text-[11px] font-telemetry text-slate-400 z-10">
          <span class="hover:text-white transition-colors cursor-pointer">0:00 The Contractor Trap</span>
          <span class="hover:text-white transition-colors cursor-pointer">0:28 Manometer Floor Survey</span>
          <span class="hover:text-white transition-colors cursor-pointer">0:54 The Texas PE Difference</span>
          <span class="hover:text-white transition-colors cursor-pointer">1:15 Same-Day Stamped Report</span>
        </div>

      </div>

      <!-- Action Strip Below Video -->
      <div class="p-5 sm:p-6 bg-slate-900/90 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-xs text-slate-300 font-telemetry text-center sm:text-left">
          <span class="text-emerald-400 font-bold">100% INDEPENDENT:</span> FSI does not sell foundation repairs or accept referral commissions.
        </div>
        <a 
          href="#schedule" 
          class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-lg shadow-blue-600/30 transition-all text-center whitespace-nowrap"
        >
          Schedule Your PE Inspection →
        </a>
      </div>

    </div>

  </div>
</section>

<!-- Modal Container -->
<div id="vsl-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl flex items-center justify-center p-4 hidden">
  <div class="relative w-full max-w-4xl bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden shadow-2xl">
    <div class="flex items-center justify-between p-4 border-b border-slate-800">
      <span class="text-sm font-bold text-white font-telemetry">FSI 90-Second Engineering Reality Check</span>
      <button id="close-vsl-btn" class="w-8 h-8 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center font-bold">
        ✕
      </button>
    </div>
    <div class="aspect-video w-full bg-black flex items-center justify-center p-8 text-center">
      <div class="max-w-lg space-y-4">
        <div class="w-16 h-16 rounded-full bg-blue-600/20 text-blue-400 flex items-center justify-center mx-auto text-2xl font-bold">
          ⚡
        </div>
        <h4 class="text-lg font-bold text-white">The Engineering Reality Check (Audio & Video Transcript)</h4>
        <p class="text-xs text-slate-300 leading-relaxed text-left bg-slate-900 p-4 rounded-xl border border-slate-800 max-h-60 overflow-y-auto">
          "If you are under contract on a Dallas-Fort Worth home, or you just discovered a crack in your sheetrock, stop before you call a foundation repair company for a 'free estimate'. That free estimate could cost you $25,000 in unnecessary repairs. Foundation companies employ commissioned salesmen whose only job is to sell piers. At FSI, we are licensed Professional Engineers. We do not sell repairs. We bring digital manometers to map your elevation contours down to 0.01 inches. Over 60% of homes we evaluate require zero underpinning. And your report is delivered the exact same day."
        </p>
        <div class="pt-2">
          <a href="#schedule" class="close-modal-and-schedule inline-block px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs">
            Proceed to Book Inspection →
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('vsl-modal');
    const playTrigger = document.getElementById('video-play-trigger');
    const heroBtn = document.getElementById('open-vsl-btn');
    const closeBtn = document.getElementById('close-vsl-btn');
    const closeAndSchedule = document.querySelectorAll('.close-modal-and-schedule');

    function openModal() {
      if (modal) modal.classList.remove('hidden');
    }

    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }

    if (playTrigger) playTrigger.addEventListener('click', openModal);
    if (heroBtn) heroBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    closeAndSchedule.forEach(btn => btn.addEventListener('click', closeModal));

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
  });
</script>
