---
// src/components/RiskGuarantees.astro
---

<section class="py-24 bg-[#070B14] text-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Vault Container with Emerald Glow Border -->
    <div class="rounded-3xl p-8 sm:p-14 bg-gradient-to-b from-[#0B111E] to-[#070B14] border-2 border-emerald-500/40 shadow-2xl relative overflow-hidden">
      <!-- Watermark Background -->
      <div class="absolute -right-10 -bottom-10 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top Tag -->
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-telemetry uppercase tracking-wider mb-4">
          ★ The FSI Engineering Shield
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
          The Triple Engineering Guarantee.
        </h2>
        <p class="mt-4 text-slate-300 text-sm sm:text-base">
          Engineered to completely eliminate friction, financial risk, and timeline panic.
        </p>
      </div>

      <!-- 3 Guarantees Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Guarantee 1 -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-black mb-4 border border-emerald-500/20 font-telemetry">
              01
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Same-Day Delivery Guarantee</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              We guarantee your official stamped PE report is delivered digitally on the exact calendar day of your inspection. If we fail to deliver on schedule during your active option period, your inspection fee is discounted 50%.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800 text-[11px] font-telemetry text-emerald-400 font-bold">
            ✓ Option-Period Protected
          </div>
        </div>

        <!-- Guarantee 2 -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center font-black mb-4 border border-blue-500/20 font-telemetry">
              02
            </div>
            <h3 class="text-lg font-bold text-white mb-2">0% Repair Sales Conflict</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              FSI guarantees that we do not bid on, perform, or sell foundation repairs, nor do we accept referral fees from contractors. You receive 100% unbiased scientific truth backed by Texas state engineering ethics.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800 text-[11px] font-telemetry text-blue-400 font-bold">
            ✓ 100% Unbiased Truth
          </div>
        </div>

        <!-- Guarantee 3 -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-black mb-4 border border-purple-500/20 font-telemetry">
              03
            </div>
            <h3 class="text-lg font-bold text-white mb-2">100% Legal & Lender Acceptance</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Every document is authored by a Texas Licensed PE. We guarantee our report satisfies all engineering requirements for city permits, title companies, and mortgage underwriters (FHA, VA, Conventional).
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800 text-[11px] font-telemetry text-purple-400 font-bold">
            ✓ Legal PE Seal Validity
          </div>
        </div>

      </div>

      <!-- Action Button -->
      <div class="mt-12 text-center">
        <a 
          href="#schedule" 
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl font-bold text-sm text-white bg-blue-600 hover:bg-blue-500 shadow-xl shadow-blue-600/30 transition-all hover:-translate-y-0.5"
        >
          Book With 100% Guarantee Protection →
        </a>
      </div>

    </div>

  </div>
</section>
