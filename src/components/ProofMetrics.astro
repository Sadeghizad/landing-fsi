---
// src/components/ProofMetrics.astro
---

<section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="rounded-2xl bg-[#0B111E] border border-slate-800 shadow-2xl overflow-hidden">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-slate-800/80">
      
      <!-- Metric 1 -->
      <div class="p-6 sm:p-8 flex flex-col justify-between group hover:bg-slate-900/50 transition-colors">
        <div>
          <span class="block text-4xl sm:text-5xl font-black text-white tracking-tight leading-none mb-2">
            0%
          </span>
          <span class="block text-xs font-telemetry uppercase tracking-wider text-red-400 font-bold mb-2">
            REPAIR SALES CONFLICT
          </span>
          <p class="text-xs text-slate-400 leading-relaxed">
            We never sell, bid on, or perform foundation repairs. Our only incentive is 100% scientific objectivity.
          </p>
        </div>
      </div>

      <!-- Metric 2 -->
      <div class="p-6 sm:p-8 flex flex-col justify-between group hover:bg-slate-900/50 transition-colors">
        <div>
          <span class="block text-4xl sm:text-5xl font-black text-blue-400 tracking-tight leading-none mb-2">
            100%
          </span>
          <span class="block text-xs font-telemetry uppercase tracking-wider text-blue-300 font-bold mb-2">
            LICENSED TEXAS PE
          </span>
          <p class="text-xs text-slate-400 leading-relaxed">
            Every evaluation is conducted strictly under Texas Board of Professional Engineers standards and legal liability.
          </p>
        </div>
      </div>

      <!-- Metric 3 -->
      <div class="p-6 sm:p-8 flex flex-col justify-between group hover:bg-slate-900/50 transition-colors">
        <div>
          <span class="block text-4xl sm:text-5xl font-black text-emerald-400 tracking-tight leading-none mb-2">
            SAME-DAY
          </span>
          <span class="block text-xs font-telemetry uppercase tracking-wider text-emerald-300 font-bold mb-2">
            REPORT DELIVERY
          </span>
          <p class="text-xs text-slate-400 leading-relaxed">
            Fast turnaround engineered specifically to protect buyers during time-sensitive Texas real estate option periods.
          </p>
        </div>
      </div>

      <!-- Metric 4 -->
      <div class="p-6 sm:p-8 flex flex-col justify-between group hover:bg-slate-900/50 transition-colors">
        <div>
          <span class="block text-4xl sm:text-5xl font-black text-white tracking-tight leading-none mb-2">
            ±0.01"
          </span>
          <span class="block text-xs font-telemetry uppercase tracking-wider text-slate-300 font-bold mb-2">
            MANOMETER PRECISION
          </span>
          <p class="text-xs text-slate-400 leading-relaxed">
            Electronic digital floor level surveys pinpointing millimeter-level settlement contours across the entire footprint.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
