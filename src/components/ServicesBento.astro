---
// src/components/ServicesBento.astro
---

<section class="py-24 bg-[#0B111E] text-white relative" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-400/20 text-blue-300 text-xs font-telemetry uppercase tracking-wider mb-4">
        Engineering Services Portfolio
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
        Comprehensive Structural & Foundation Engineering Services.
      </h2>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        Conducted under strict Texas Board of Professional Engineers standards across the entire Dallas-Fort Worth metroplex.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      <!-- Card 1: Single Family Residential (8 Cols) -->
      <div class="md:col-span-8 glass-card rounded-3xl p-8 sm:p-10 border border-slate-700/80 flex flex-col justify-between group glass-card-interactive">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-telemetry font-bold">
              PRIMARY CORE DISPATCH
            </span>
            <span class="text-xs font-telemetry text-slate-400">01 / RESIDENTIAL</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-3 group-hover:text-blue-400 transition-colors">
            Single Family Residential Foundation & Framing Inspections
          </h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
            Comprehensive structural diagnostics for single-family homes throughout DFW. Pinpointing slab deflection, foundation settlement, sheetrock cracking, and door misalignments with digital manometer precision.
          </p>
          <div class="flex flex-wrap gap-2 text-xs font-telemetry text-slate-300 mb-6">
            <span class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800">✓ Electronic Floor Survey</span>
            <span class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800">✓ Texas PE Seal Affixed</span>
            <span class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800">✓ Same-Day Delivery</span>
          </div>
        </div>

        <a 
          href="#schedule" 
          class="inline-flex items-center text-sm font-bold text-blue-400 group-hover:text-blue-300 transition-colors"
        >
          Schedule Residential Inspection →
        </a>
      </div>

      <!-- Card 2: Commercial Inspections (4 Cols) -->
      <div class="md:col-span-4 glass-card rounded-3xl p-8 border border-slate-700/80 flex flex-col justify-between group glass-card-interactive">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-xs font-telemetry font-bold">
              COMMERCIAL
            </span>
            <span class="text-xs font-telemetry text-slate-400">02 / DUE DILIGENCE</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">
            Commercial & Industrial Inspections
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            Rigorous evaluations for retail centers, offices, industrial spaces, and warehouses. Certified PE reports tailored for commercial loans, SBA underwriting, and municipal compliance.
          </p>
        </div>

        <a href="#schedule" class="inline-flex items-center text-xs font-bold text-blue-400 group-hover:text-blue-300 transition-colors">
          Commercial Inquiry →
        </a>
      </div>

      <!-- Card 3: Multi-Family Residential (4 Cols) -->
      <div class="md:col-span-4 glass-card rounded-3xl p-8 border border-slate-700/80 flex flex-col justify-between group glass-card-interactive">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-xs font-telemetry font-bold">
              MULTI-UNIT
            </span>
            <span class="text-xs font-telemetry text-slate-400">03 / MULTI-FAMILY</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">
            Multi-Family & Townhome Reviews
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            Structural assessments across duplexes, apartment complexes, and townhomes. Evaluating shared foundation stresses and localized soil movement.
          </p>
        </div>

        <a href="#schedule" class="inline-flex items-center text-xs font-bold text-blue-400 group-hover:text-blue-300 transition-colors">
          Multi-Family Audit →
        </a>
      </div>

      <!-- Card 4: New Construction (4 Cols) -->
      <div class="md:col-span-4 glass-card rounded-3xl p-8 border border-slate-700/80 flex flex-col justify-between group glass-card-interactive">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-xs font-telemetry font-bold">
              NEW BUILD
            </span>
            <span class="text-xs font-telemetry text-slate-400">04 / PHASE INSPECTION</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">
            New Construction & Pre-Pour Audits
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            Pre-pour slab reviews, post-tension cable placement verification, and framing compliance audits before insulation and drywall conceal structural flaws.
          </p>
        </div>

        <a href="#schedule" class="inline-flex items-center text-xs font-bold text-blue-400 group-hover:text-blue-300 transition-colors">
          Phase Inspection Schedule →
        </a>
      </div>

      <!-- Card 5: Remodeling & Wall Removal (4 Cols) -->
      <div class="md:col-span-4 glass-card rounded-3xl p-8 border border-slate-700/80 flex flex-col justify-between group glass-card-interactive">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-xs font-telemetry font-bold">
              REMODELING
            </span>
            <span class="text-xs font-telemetry text-slate-400">05 / WALL REMOVAL</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">
            Load-Bearing Wall Removal & Sizing
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            Expert structural engineering consultations for open-concept renovations. Precise sizing for LVL or steel beams, point load calculations, and city permit packages.
          </p>
        </div>

        <a href="#schedule" class="inline-flex items-center text-xs font-bold text-blue-400 group-hover:text-blue-300 transition-colors">
          Wall Removal Review →
        </a>
      </div>

      <!-- Card 6: Additions & Expansions (Full Width Strip - 12 Cols) -->
      <div class="md:col-span-12 glass-card rounded-3xl p-6 sm:p-8 border border-slate-700/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 group glass-card-interactive">
        <div class="space-y-2 max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-telemetry font-bold">
              STRUCTURAL EXTENSIONS
            </span>
            <span class="text-xs font-telemetry text-slate-400">06 / ADDITIONS</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-white">
            Additions, Second Stories & Foundation Tying
          </h3>
          <p class="text-xs sm:text-sm text-slate-300">
            Engineering analysis for vertical and horizontal home expansions, garage conversions, and foundation tying specifications to prevent differential settling between existing and new concrete.
          </p>
        </div>
        <a 
          href="#schedule" 
          class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs border border-slate-700 transition-all whitespace-nowrap"
        >
          Consult on Expansion →
        </a>
      </div>

    </div>

  </div>
</section>
