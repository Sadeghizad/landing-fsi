---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "FSI - Professional Foundation & Structural Inspection Services across the DFW (Dallas-Fort Worth) area by Texas licensed Professional Engineers (PE). Same-Day Stamped Reports." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | FSI - Foundation Structure Inspection</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#070B14] text-slate-100 antialiased min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <MobileStickyBar />
  </body>
</html>
